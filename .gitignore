# ---------------------------------------------------------------------------
# Project data. None of this is redistributed: the corpus is rebuilt from the
# arXiv API, the CORE portal and DBLP by running the pipeline (see README).
# ---------------------------------------------------------------------------

# Downloaded arXiv PDFs (~10 GB)
data/pdf/

# Reference datasets downloaded from the CORE portal
data/CORE2023.csv
data/CORE_journals.csv

# Everything else produced by the pipeline
data/
*.xlsx

# Generated analysis artefacts
articles.json
pdf_analysis*.json
matched_results.*
*.joblib
*.pkl

# Generated figures
figures/
*.png

# Local LLM experiment outputs
llm_*.txt
